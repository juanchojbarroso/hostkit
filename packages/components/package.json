{
  "name": "@hostkit-ui/components",
  "version": "0.0.0",
  "description": "Framework-agnostic hostkit components, built with Lit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanchojbarroso/hostkit.git",
    "directory": "packages/components"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./button.js": {
      "types": "./dist/button.d.ts",
      "default": "./dist/button.js"
    },
    "./all.js": {
      "types": "./dist/all.d.ts",
      "default": "./dist/all.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/button.js",
    "./dist/all.js"
  ],
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "cdn",
    "custom-elements.json"
  ],
  "scripts": {
    "build": "pnpm run build:dist && pnpm run build:cdn",
    "build:dist": "node scripts/build-dist.mjs && tsc -p tsconfig.build.json && cem analyze",
    "build:cdn": "node scripts/build-cdn.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "peerDependencies": {
    "@hostkit-ui/tokens": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@hostkit-ui/tokens": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@hostkit-ui/tokens": "workspace:*",
    "@vitest/browser-playwright": "^5.0.5",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
